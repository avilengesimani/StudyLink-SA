<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/flashcardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flashcards"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create flashcards to help you revise your subjects."
            android:textSize="16sp"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etFlashcardSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject"/>

        <EditText
            android:id="@+id/etFlashcardQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Question / Term"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/etFlashcardAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Answer / Definition"
            android:gravity="top"
            android:minLines="3"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnAddFlashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Flashcard"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/tvFlashcardCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Flashcards: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>